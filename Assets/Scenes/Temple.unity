--- !u!114 &1482947872
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1482947871}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 867c5f5921aab324e93a4ff374592420, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AIAdventure.Level.IntroCutscene
  player: {fileID: 1958986882}
  cameraFollow: {fileID: 1943347}
  cameraSpeed: 1.5
  shots:
  - cameraPoint: {fileID: 1591352967}
    lookAt: {fileID: 1865816371}
    speakerName: Sen
    portrait: {fileID: 2800000, guid: 54dd82a296e37a143b29f730e3c12643, type: 3}
    text: "Leyla'y\u0131 ka\xE7\u0131rd\u0131lar. \u0130z bu tap\u0131na\u011Fa \xE7\u0131k\u0131yor."
    duration: 4
  - cameraPoint: {fileID: 1591352967}
    lookAt: {fileID: 1865816371}
    speakerName: Sen
    portrait: {fileID: 0}
    text: "Parmakl\u0131k kilitli. Zorla a\xE7\u0131lacak gibi de\u011Fil."
    duration: 4
  - cameraPoint: {fileID: 1115102096}
    lookAt: {fileID: 1936446804}
    speakerName: Sen
    portrait: {fileID: 0}
    text: "Duvar\u0131n dibinde dar bir delik var. \xD6b\xFCr tarafta bir kol...\n"
    duration: 4
  - cameraPoint: {fileID: 28661484}
    lookAt: {fileID: 1475334070}
    speakerName: Sen
    portrait: {fileID: 0}
    text: "Ben s\u0131\u011Fmam ama o s\u0131\u011Far. Cebimde bir par\xE7a et vard\u0131."
    duration: 4
  lettersPerSecond: 40
  slideDuration: 0.35
  boxColor: {r: 0.05, g: 0.04, b: 0.03, a: 0.85}
  frameColor: {r: 0.75, g: 0.6, b: 0.35, a: 1}
  endHint: "Tilkinin yan\u0131na git, kolun yak\u0131n\u0131nda E'ye bas."
  endHintDuration: 6
